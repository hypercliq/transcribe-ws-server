# Copy to .env in the repository root and replace the token and AWS credentials.
AWS_REGION=eu-west-1
PORT=3000
API_TOKENS='["replace-with-a-long-random-token"]'

# Development requires npm ci including development dependencies.
# Set NODE_ENV=production when deploying with npm ci --omit=dev.
NODE_ENV=development
LOG_LEVEL=info
LOG_FILE=logs/combined.log
LOG_TRANSCRIPTS=false

# The server uses the AWS environment credential provider, not the default chain.
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
# For temporary credentials, also set AWS_SESSION_TOKEN.
# AWS_SESSION_TOKEN=replace-with-your-session-token
